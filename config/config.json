{
    "LeakThreshold": 1000,
    "NonPagedPoolThreshold": 70,
    "StormThreshold": 200,
    "WatchdogIntervalSeconds": 60,

    "EnableJsonExport": true,
    "EnableCsvExport": true,
    "TrendWindow": 20,
    "EnablePredictiveAlerts": true,

    "CooldownSeconds": 300,
    "EnableWebhooks": false,
    "WebhookUrl": "",
    "WebhookMinHealthScore": 60,

    "TimestampFormat": "ISO8601",
    "UseUtc": true,
    "ClockDriftThresholdSeconds": 2,

    "EnableQuarantine": true,
    "QuarantineRestartLimit": 3,
    "QuarantineWindowMinutes": 10,

    "EnableAutoKill": true,
    "AutoKillProcesses": [ "ArmouryWebBrowserEdge", "GameVisual" ],
    "AutoKillMemThresholdMB": 500,

    "Weights": {
        "ServiceLeak": 40,
        "NonPagedPressure": 25,
        "Storm": 20,
        "TcpLoad": 10,
        "UdpLoad": 5
    },
    
    "MonitoredServices": [
        {
            "ServiceName": "LightingService",
            "ProcessTree": ["LightingService", "AuraService"],
            "MaxTcpConnections": 1000,
            "EnableRestart": true
        }
    ]
}