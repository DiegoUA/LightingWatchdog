{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "WatchdogSettings": {
    "WatchdogIntervalSeconds": 30,
    "CooldownSeconds": 120,
    "EnableQuarantine": true,
    "QuarantineWindowMinutes": 60,
    "QuarantineRestartLimit": 3,
    "MonitoredServices": [
      {
        "ServiceName": "LightingService",
        "ProcessTree": [
          "LightingService",
          "AuraService"
        ],
        "MaxTcpConnections": 150,
        "EnableRestart": true
      }
    ]
  }
}