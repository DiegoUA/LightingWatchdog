{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "WatchdogConfig": {
    "WatchdogIntervalSeconds": 15,
    "CooldownSeconds": 120,
    "EnableQuarantine": true,
    "QuarantineWindowMinutes": 60,
    "QuarantineRestartLimit": 3,
    "MonitorAllProcesses": true,
    "GlobalMaxTcpConnections": 1000,
    "Syslog": {
      "Enabled": false,
      "ServerIp": "127.0.0.1",
      "Port": 514
    },
    "MonitoredServices": [
      {
        "ServiceName": "LightingService",
        "ProcessTree": [
          "LightingService",
          "AuraService"
        ],
        "MaxTcpConnections": 1000,
        "EnableRestart": true
      }
    ]
  }
}
